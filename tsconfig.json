{
  // Only used for type checking (npm run typecheck). Node runs the .ts files itself by stripping the types,
  // so imports name the .ts file and the code uses only syntax that can be stripped (no enums, no namespaces).
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["app/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
